{
  "tools": [
    {
      "description": "Resolve effective rules for the operator-bound execution context, then load non-rule core recall memories. Policy conflicts fail the whole request.",
      "inputSchema": {
        "$defs": {
          "ResolutionContext": {
            "additionalProperties": false,
            "description": "Trusted execution facts. Missing and explicitly empty sets have different meanings.",
            "properties": {
              "language": {
                "description": "Known languages, including an empty set when none apply.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              },
              "phase": {
                "description": "Current work phase, if asserted by orchestration.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "profile": {
                "description": "The execution target, such as `workstation-host` or `woodpecker-container`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool": {
                "description": "Known tools, including an empty set when none apply.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "context": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResolutionContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional assertion that must agree with the operator-bound execution context"
          },
          "include_general": {
            "description": "Whether to include rules stored under the shared `general` project",
            "type": [
              "boolean",
              "null"
            ]
          },
          "include_recall": {
            "description": "Whether to include non-rule core recall memories alongside rules",
            "type": [
              "boolean",
              "null"
            ]
          },
          "project": {
            "description": "Project name to bootstrap",
            "type": "string"
          }
        },
        "required": [
          "project"
        ],
        "title": "BootstrapParams",
        "type": "object"
      },
      "name": "memory_bootstrap"
    },
    {
      "description": "Delete a memory by UUID",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "UUID of the memory to delete",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "DeleteParams",
        "type": "object"
      },
      "name": "memory_delete"
    },
    {
      "description": "Retrieve a single memory by UUID",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "UUID of the memory to retrieve",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "GetParams",
        "type": "object"
      },
      "name": "memory_get"
    },
    {
      "description": "Browse memories by project with optional category filter, paginated",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "category": {
            "description": "Filter by category: `context`, `decision`, `error_fix`, `plan`, `rule`",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Maximum number of results (default: 20, max: 100)",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "default": null,
            "description": "Offset for pagination (default: 0)",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "project": {
            "description": "Project name to list memories for",
            "type": "string"
          },
          "tags": {
            "description": "Filter to memories containing all of these exact tags",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "project"
        ],
        "title": "ListParams",
        "type": "object"
      },
      "name": "memory_list"
    },
    {
      "description": "The follow-up inspection tool after a promising memory_search or memory_get result. Exposes graph-connected context around a known memory, useful for tracing related decisions, plans, fixes, or rules.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "UUID of the memory to find neighbors for",
            "format": "uuid",
            "type": "string"
          },
          "limit": {
            "default": null,
            "description": "Maximum number of neighbors to return (default: 20, max: 100)",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "title": "ListNeighborsParams",
        "type": "object"
      },
      "name": "memory_neighbors"
    },
    {
      "description": "Recall core memories (importance >= 0.7) for a project at session start",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "include_workflow_artifacts": {
            "description": "Include task-scoped workflow artifacts (default: false)",
            "type": [
              "boolean",
              "null"
            ]
          },
          "project": {
            "description": "Project name to recall core memories for",
            "type": "string"
          }
        },
        "required": [
          "project"
        ],
        "title": "RecallParams",
        "type": "object"
      },
      "name": "memory_recall"
    },
    {
      "description": "Resolve effective project and mandatory general policies for the operator-bound execution context. Tags filter contextual guidance only; they cannot select a profile or hide mandatory policies.",
      "inputSchema": {
        "$defs": {
          "ResolutionContext": {
            "additionalProperties": false,
            "description": "Trusted execution facts. Missing and explicitly empty sets have different meanings.",
            "properties": {
              "language": {
                "description": "Known languages, including an empty set when none apply.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              },
              "phase": {
                "description": "Current work phase, if asserted by orchestration.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "profile": {
                "description": "The execution target, such as `workstation-host` or `woodpecker-container`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool": {
                "description": "Known tools, including an empty set when none apply.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "context": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResolutionContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional assertion that must agree with the operator-bound execution context"
          },
          "include_general": {
            "description": "Whether to include optional general contextual guidance; mandatory general policies always participate",
            "type": [
              "boolean",
              "null"
            ]
          },
          "project": {
            "description": "Project name to load rules for",
            "type": "string"
          },
          "shadow_general": {
            "description": "Permit equal-or-narrower same-key project overrides of contextual general policies",
            "type": [
              "boolean",
              "null"
            ]
          },
          "tags": {
            "description": "Filter effective contextual rules by ALL-of tags; this cannot select an execution context",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "project"
        ],
        "title": "RulesParams",
        "type": "object"
      },
      "name": "memory_rules"
    },
    {
      "description": "The default retrieval entrypoint. Performs hybrid durable-memory search, expands via the memory graph, and may fall back to session-log search when no durable memories match. Query expansion and semantic reranking are opt-in (disabled by default) and can be requested for higher quality at the cost of latency. Targeted worker workflows should use `tags` to exclusively filter search hits.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "category": {
            "description": "Filter by category: `context`, `decision`, `error_fix`, `plan`, `rule`",
            "type": [
              "string",
              "null"
            ]
          },
          "cross_project": {
            "description": "Allow graph expansion into foreign projects (default: false)",
            "type": [
              "boolean",
              "null"
            ]
          },
          "expand_query": {
            "description": "Expand search query using an LLM (default: false)",
            "type": [
              "boolean",
              "null"
            ]
          },
          "graph_hops": {
            "default": null,
            "description": "Number of graph hops for expansion (default: 1)",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "include_general": {
            "description": "Include edges to/from the `general` project during expansion (default: false)",
            "type": [
              "boolean",
              "null"
            ]
          },
          "include_workflow_artifacts": {
            "description": "Include task-scoped workflow artifacts (default: false)",
            "type": [
              "boolean",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Maximum number of results (default: 5, max: 100)",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "min_similarity": {
            "description": "Minimum similarity threshold (default: 0.5, range: 0.0-1.0)",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "project": {
            "description": "Project name to search within",
            "type": "string"
          },
          "project_allowlist": {
            "description": "Restrict cross-project expansion to these projects only",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "query": {
            "description": "Natural language search query",
            "type": "string"
          },
          "rerank": {
            "description": "Apply semantic reranking to the results (default: false)",
            "type": [
              "boolean",
              "null"
            ]
          },
          "tags": {
            "description": "Filter to memories containing all of these exact tags",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "project",
          "query"
        ],
        "title": "SearchParams",
        "type": "object"
      },
      "name": "memory_search"
    },
    {
      "description": "Return the memory server version (includes git hash)",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "memory_server_version"
    },
    {
      "description": "Store a new memory. Each memory should cover one concept — prefer creating focused memories over expanding existing ones. Mentioning a UUID in content or using structural tags (plan:<uuid>, reviewed-item:<uuid>) creates graph edges at write time. Shared topical tags and embedding similarity create edges during maintenance.",
      "inputSchema": {
        "$defs": {
          "DeliveryClass": {
            "description": "Whether a policy is contextual guidance or requires later mandatory delivery.",
            "oneOf": [
              {
                "const": "contextual",
                "description": "Delivered only through the existing contextual rule filters.",
                "type": "string"
              },
              {
                "const": "mandatory",
                "description": "Marked for mandatory delivery by a future policy resolver.",
                "type": "string"
              }
            ]
          },
          "PolicySelectors": {
            "additionalProperties": false,
            "description": "Structured execution domain of a policy. An omitted dimension is universal.",
            "properties": {
              "language": {
                "description": "Source languages accepted by this policy.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              },
              "phase": {
                "description": "Work phases accepted by this policy.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              },
              "profile": {
                "description": "Execution target profiles accepted by this policy.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              },
              "tool": {
                "description": "Tools accepted by this policy.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              }
            },
            "type": "object"
          },
          "PolicyWrite": {
            "additionalProperties": false,
            "description": "Complete client supplied metadata for a new policy revision.",
            "properties": {
              "delivery_class": {
                "$ref": "#/$defs/DeliveryClass",
                "description": "Classification of this revision."
              },
              "policy_key": {
                "description": "Stable key within the memory's project; 1–128 ASCII bytes.",
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "revision": {
                "description": "Positive revision number, stored in a signed 64-bit database column.",
                "format": "int64",
                "minimum": 1,
                "type": "integer"
              },
              "selectors": {
                "$ref": "#/$defs/PolicySelectors",
                "default": {},
                "description": "Structured execution domain; omitted dimensions match all executions."
              },
              "supersedes": {
                "description": "Current active predecessor, omitted for a root revision.",
                "format": "uuid",
                "type": [
                  "string",
                  "null"
                ]
              },
              "values": {
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Exact requirements shared with other effective policies.",
                "type": "object"
              }
            },
            "required": [
              "policy_key",
              "revision",
              "delivery_class"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "category": {
            "description": "Memory category: `context`, `decision`, `error_fix`, `plan`, or `rule`",
            "type": "string"
          },
          "content": {
            "description": "Full content of the memory",
            "type": "string"
          },
          "policy": {
            "anyOf": [
              {
                "$ref": "#/$defs/PolicyWrite"
              },
              {
                "type": "null"
              }
            ],
            "description": "Complete policy metadata for a classified Rule revision"
          },
          "project": {
            "description": "Project this memory belongs to",
            "type": "string"
          },
          "summary": {
            "description": "Brief summary for display and embedding",
            "type": "string"
          },
          "tags": {
            "description": "Optional tags for organization",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "category",
          "content",
          "project",
          "summary"
        ],
        "title": "StoreParams",
        "type": "object"
      },
      "name": "memory_store"
    },
